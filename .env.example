NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Nebius Token Factory (OpenAI-compatible chat completions). Set a model ID from your Nebius account.
AI_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=

# Optional OpenAI-compatible fallback. Set AI_PROVIDER=openai to use it instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional TURN relay for calls across restrictive NATs/firewalls.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
